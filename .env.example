# Copy this file to .env and fill in values from your existing deployment.
PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
TRUST_PROXY=false

# Optional staging/browser test credentials. Do not use production credentials.
GMCRM_STAGING_URL=
GMCRM_STAGING_SUPERADMIN_PHONE=
GMCRM_STAGING_SUPERADMIN_PASSWORD=
GMCRM_STAGING_NON_SUPER_PHONE=
GMCRM_STAGING_NON_SUPER_PASSWORD=
GMCRM_E2E_PHONE=
GMCRM_E2E_PASSWORD=

# Backblaze B2 (photos, documents, backups). When all four are set, files go to B2.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_ENDPOINT=s3.us-west-004.backblazeb2.com

# Only for tools/copy-old-to-new.js (one-time copy from the old Supabase)
OLD_SUPABASE_URL=
OLD_SUPABASE_SERVICE_KEY=
OLD_SUPABASE_BUCKET=gm-files

# Copy employees into the new GT-CRM tables as they are saved (1 = on). Turn on only after running sql/002_employees_sync.sql.
GT_SYNC_EMPLOYEES=

# Same for products, vehicles, routes and customers (1 = on). Turn on only after running sql/003_catalog_sync.sql and copying once.
GT_SYNC_CATALOG=

# Same for sales orders, shop visits and returns (1 = on). Turn on only after running sql/004_sales_sync.sql and copying once.
GT_SYNC_SALES=

# Same for delivery plans and pin tasks (1 = on). Turn on only after running sql/005_plans_sync.sql and copying once.
GT_SYNC_PLANS=

# Same for attendance, leaves and admin notifications (1 = on). Turn on only after running sql/006_attendance_sync.sql and copying once.
GT_SYNC_ATTENDANCE=
