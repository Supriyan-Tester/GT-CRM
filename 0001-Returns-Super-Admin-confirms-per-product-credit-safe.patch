+      // Send the returns to the office's returns queue (quarantine + Super Admin check).
+      // If the phone is offline the request is kept and retried the next time this screen opens.
+      var RQ_KEY = "gm_route_returns_queue";
+      function rqRead() {
+        try {
+          return JSON.parse(localStorage.getItem(RQ_KEY) || "[]");
+        } catch (e) {
+          return [];
+        }
+      }
+      function rqWrite(q) {
+        try {
+          localStorage.setItem(RQ_KEY, JSON.stringify(q));
+        } catch (e) {}
+      }
+      function rqFlush() {
+        var q = rqRead();
+        if (!q.length) return;
+        var next = q[0];
+        fetch("/api/worker/route-returns", {
+          method: "POST",
+          credentials: "same-origin",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify(next),
+        })
+          .then(function (r) {
+            // 4xx means the office rejected the data itself: drop it so it cannot block the queue. 5xx / offline: keep and retry.
+            if (r.ok || (r.status >= 400 && r.status < 500 && r.status !== 401 && r.status !== 408 && r.status !== 429)) {
+              var cur = rqRead();
+              cur.shift();
+              rqWrite(cur);
+              if (cur.length) rqFlush();
+            }
+          })
+          .catch(function () {});
+      }
+      function sendRouteReturns(payload) {
+        var q = rqRead();
+        q.push(payload);
+        rqWrite(q);
+        rqFlush();
+      }
+      rqFlush();
